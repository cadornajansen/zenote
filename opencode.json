{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure/gpt-6-astra",
  "small_model": "assemblyai/gpt-5-mini",
  "plugin": ["@upstash/context7-opencode"],
  "mcp": {
    "appwrite": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.appwrite.io"
    },
    "anysearch": {
      "type": "remote",
      "url": "https://api.anysearch.com/mcp",
      "enabled": true,
      "oauth": false,
      "timeout": 10000,
      "headers": {
        "Authorization": "Bearer {env:ANYSEARCH_API_KEY}"
      }
    },
    "code-review-graph": {
      "type": "local",
      "command": [
        "uvx",
        "code-review-graph",
        "serve",
        "--repo",
        "C:\\Development\\open-source\\zenote-chat"
      ],
      "enabled": true
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agent": {
    "build": {
      "description": "Primary Zenote engineering agent. Owns implementation, final technical decisions, fixes, and orchestration of specialized subagents.",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "research": "allow",
          "architect": "allow",
          "test": "allow",
          "review": "allow"
        }
      }
    },
    "plan": {
      "description": "Read-only planning agent for implementation planning and technical analysis.",
      "mode": "primary",
      "model": "openai/gpt-6-astra",
      "steps": 8,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "research": "allow"
        }
      }
    },
    "architect": {
      "description": "Senior architecture consultant. Use only for difficult, ambiguous, or high-impact engineering decisions. Challenge complexity and return the simplest robust implementation plan. Never edit.",
      "mode": "subagent",
      "model": "azure/gpt-5.6-sol",
      "steps": 6,
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  },
  "provider": {
    "meta": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Meta Model API",
      "options": {
        "baseURL": "https://api.meta.ai/v1",
        "apiKey": "{env:MODEL_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor"
        }
      }
    },
    "azure": {
      "name": "Azure OpenAI",
      "options": {
        "resourceName": "zen-harness-resource"
      },
      "models": {
        "gpt-6-astra": {
          "id": "gpt-6-astra",
          "name": "GPT-6 Astra"
        }
      }
    },
    "google": {
      "name": "Google Gemini",
      "models": {
        "gemini-3.7-flash": {
          "id": "gemini-3.7-flash",
          "name": "Gemini 3.7 Flash"
        }
      }
    },
    "deepseek-direct": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek Direct",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "id": "deepseek-flash",
          "name": "DeepSeek V4.1 Flash"
        }
      }
    },
    "amazon-bedrock": {
      "name": "Amazon Bedrock",
      "options": {
        "region": "us-east-1"
      },
      "models": {
        "zai.glm-5": {
          "id": "zai.glm-5",
          "name": "GLM 5"
        }
      }
    },
    "assemblyai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AssemblyAI LLM Gateway",
      "options": {
        "baseURL": "https://llm-gateway.assemblyai.com/v1",
        "headers": {
          "Authorization": "{env:ASSEMBLYAI_API_KEY}"
        }
      },
      "models": {
        "gpt-5-nano": {
          "name": "GPT-5 Nano",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-5-mini": {
          "name": "GPT-5 Mini",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1"
        },
        "gpt-5": {
          "name": "GPT-5",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-5.1": {
          "name": "GPT-5.1",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-5.2": {
          "name": "GPT-5.2",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "options": {
            "reasoningEffort": "none"
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5"
        },
        "claude-sonnet-4-5-20250929": {
          "name": "Claude Sonnet 4.5"
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-opus-4-5-20251101": {
          "name": "Claude Opus 4.5"
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6"
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7"
        },
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "gemini-2.5-flash-lite": {
          "name": "Gemini 2.5 Flash Lite"
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash"
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro"
        },
        "gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite"
        },
        "gemini-3.5-flash-lite": {
          "name": "Gemini 3.5 Flash Lite"
        },
        "gemini-3.5-flash": {
          "name": "Gemini 3.5 Flash"
        },
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash"
        },
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash"
        },
        "gemma-4-31b": {
          "name": "Gemma 4 31B"
        },
        "qwen3-32B": {
          "name": "Qwen3 32B"
        },
        "qwen3-next-80b-a3b": {
