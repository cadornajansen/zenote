# =========================================================
# APP
# =========================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000


# =========================================================
# APPWRITE
# =========================================================

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6a9e3f7c0019355433ad

# Site server-only data/auth key: sessions.write, rows.read/write and files.write.
# Normal chat CRUD and file reads use the session. Never copy this key into the Function.
APPWRITE_API_KEY=
# Required: existing TablesDB database ID. Run pnpm setup:appwrite before serving /chat.
APPWRITE_DATABASE_ID=
# Private attachments bucket ID; setup creates it with no bucket-wide permissions.
APPWRITE_STORAGE_BUCKET_ID=

# Server-only safety admission defaults, not customer plan quotas.
ZENOTE_CHAT_ENABLED=true
ZENOTE_ATTACHMENTS_ENABLED=true
ZENOTE_CHAT_PER_MINUTE=10
ZENOTE_CHAT_PER_DAY=200
ZENOTE_CHAT_MAX_CONCURRENT=2
ZENOTE_ATTACHMENTS_PER_DAY=20
ZENOTE_ATTACHMENT_BYTES_PER_DAY=104857600
ZENOTE_ATTACHMENTS_MAX_CONCURRENT=4
ZENOTE_GLOBAL_CHAT_PER_DAY=5000
ZENOTE_GLOBAL_ATTACHMENTS_PER_DAY=500
# Must be >=300 / >=360 respectively (operation deadlines).
ZENOTE_CHAT_LEASE_SECONDS=300
ZENOTE_ATTACHMENT_LEASE_SECONDS=360

# Function-only configuration (set in Appwrite Function/project variables).
# Same IDs as APPWRITE_DATABASE_ID / APPWRITE_STORAGE_BUCKET_ID above.
ZENOTE_DATABASE_ID=
ZENOTE_STORAGE_BUCKET_ID=
ZENOTE_ATTACHMENTS_TABLE_ID=attachments
# Appwrite injects APPWRITE_FUNCTION_API_ENDPOINT, APPWRITE_FUNCTION_PROJECT_ID
# and the per-execution x-appwrite-key header; do not manually define APPWRITE_* there.


# =========================================================
# AI — ASSEMBLYAI
# =========================================================

# Secret shared project variable where possible: Site LLM Gateway + Function STT.
ASSEMBLYAI_API_KEY=
# Optional server-only gateway root, including /v1 (not /chat/completions).
ASSEMBLYAI_LLM_BASE_URL=


# =========================================================
# AI — AZURE
# =========================================================

AZURE_AI_API_KEY=
AZURE_AI_ENDPOINT=
AZURE_AI_API_VERSION=


# =========================================================
# AI — AMAZON BEDROCK
# =========================================================

# Function-only for attachments; reuse existing project variables if present.
# Mark AWS credentials (including session token) secret in Appwrite.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional when temporary credentials are used
AWS_SESSION_TOKEN=

# Application-level content encryption. Configure the same secret values for the
# Site and attachment Function. The CMK must be a symmetric customer-managed key
# in us-east-1. Never expose its ARN or AWS credentials to the browser.
ZENOTE_KMS_KEY_ARN=
ZENOTE_CRYPTO_ACTIVE_KEY_VERSION=1
# Keep legacy plaintext enabled only for a controlled migration.
ZENOTE_CRYPTO_ALLOW_LEGACY_PLAINTEXT=true

# Internal image preprocessing only, not a visible chat model. Use an invocable
# inference-profile ID, not a profile-only model's bare foundation-model ID.
BEDROCK_NOVA_MODEL_ID=global.amazon.nova-2-lite-v1:0
# AWS credentials need bedrock:InvokeModel, bedrock:GetInferenceProfile,
# textract:AnalyzeDocument for images, and textract:DetectDocumentText for scans.


# =========================================================
# AI — OPENROUTER
# =========================================================

OPENROUTER_API_KEY=

# Present in the local development environment. It is not currently consumed by Zenote.
DEEPSEEK_API_KEY=

# Optional metadata sent to OpenRouter where supported
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Zenote


# =========================================================
# PAYMENTS — PAYMONGO
# =========================================================

PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=


# =========================================================
# ANALYTICS — POSTHOG
# =========================================================

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=


# =========================================================
# MONITORING — SENTRY
# =========================================================

NEXT_PUBLIC_SENTRY_DSN=

SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# =========================================================
# EMAIL — RESEND
# =========================================================

RESEND_API_KEY=
RESEND_FROM_EMAIL=


# =========================================================
# INTERNAL
# =========================================================

# Used only if Zenote needs internal webhook/server verification.
INTERNAL_API_SECRET=
