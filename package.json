{
  "name": "zenote-chat",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:function": "npm --prefix functions/attachment-processor run build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && npm --prefix functions/attachment-processor run typecheck",
    "typecheck:function": "npm --prefix functions/attachment-processor run typecheck",
    "test": "node --test tests/*.test.mjs",
    "setup:appwrite": "node --env-file-if-exists=.env.local scripts/setup-appwrite.mjs",
    "migrate:content-encryption": "node --env-file-if-exists=.env.local scripts/migrate-content-encryption.mjs",
    "benchmark:crypto": "node scripts/crypto-benchmark.mjs",
    "test:function": "npm --prefix functions/attachment-processor test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:function && pnpm build:function && pnpm build"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1128.0",
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "@shadcn/react": "^0.3.1",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "appwrite": "^27.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.5.0",
    "katex": "^0.18.7",
    "lucide-react": "^1.42.0",
    "motion": "^13.2.0",
    "next": "16.3.3",
    "node-appwrite": "^29.0.0",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
